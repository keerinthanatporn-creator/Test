<!DOCTYPE html>

<html lang="en">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Flight Simulator 3D</title>

<style>

*{box-sizing:border-box}

body{margin:0;overflow:hidden;background:#87ceeb;

font-family:Arial,sans-serif;color:white}

canvas{display:block}

#hud{

 position:fixed;top:15px;left:15px;

 background:rgba(0,0,0,.55);

 padding:14px;border-radius:10px;

 line-height:1.8;font-size:13px;

 pointer-events:none

}

#title{

 position:fixed;top:15px;right:15px;

 background:rgba(0,0,0,.5);

 padding:10px 16px;border-radius:8px;

 font-weight:bold

}

#help{

 position:fixed;bottom:15px;left:15px;

 background:rgba(0,0,0,.5);

 padding:12px;border-radius:8px;

 font-size:12px;line-height:1.7

}

#controls{

 position:fixed;bottom:20px;right:20px;

 display:grid;grid-template-columns:repeat(3,55px);

 gap:7px;touch-action:none

}

.control{

 border:1px solid #ffffff80;

 background:#172b3bbd;color:white;

 border-radius:12px;height:52px;

 font-size:20px;touch-action:none

}

.control:active{background:#3686bd}

#reset{

 position:fixed;top:75px;right:15px;

 padding:10px;background:#172b3bcc;

 color:white;border:0;border-radius:8px

}

</style>

</head>

<body>

<div id="hud">

 SPEED: <span id="speed">0</span> KNOTS<br>

 ALTITUDE: <span id="alt">0</span> FT<br>

 HEADING: <span id="heading">000</span>°<br>

 THROTTLE: <span id="throttle">0</span>%<br>

 PITCH: <span id="pitch">0</span>°<br>

 ROLL: <span id="roll">0</span>°

</div>

<div id="title">✈ FLIGHT SIMULATOR 3D</div>

<button id="reset">RESET FLIGHT</button>

<div id="help">

 W / S : Pitch Up / Down<br>

 A / D : Roll Left / Right<br>

 Q / E : Rudder<br>

 SHIFT : Increase Throttle<br>

 CTRL : Decrease Throttle<br>

 SPACE : Air Brake

</div>

<div id="controls">

 <button class="control" data-key="w">▲</button>

 <button class="control" data-key="shift">THR+</button>

 <button class="control" data-key="q">↶</button>

 <button class="control" data-key="a">◀</button>

 <button class="control" data-key="s">▼</button>

 <button class="control" data-key="d">▶</button>

 <button class="control" data-key="e">↷</button>

 <button class="control" data-key="ctrl">THR-</button>

 <button class="control" data-key="space">BRAKE</button>

</div>

<script type="importmap">

{

 "imports":{

  "three":"https://cdn.jsdelivr.net/npm/three@0.170.0/build/three.module.js"

 }

}

</script>

<script type="module">

import * as THREE from 'three';

// SCENE

const scene = new THREE.Scene();

scene.background = new THREE.Color(0x87ceeb);

scene.fog = new THREE.Fog(0x87ceeb,300,3500);

// CAMERA

const camera = new THREE.PerspectiveCamera(

 65,window.innerWidth/window.innerHeight,0.1,5000

);

camera.position.set(0,8,20);

// RENDERER

const renderer = new THREE.WebGLRenderer({

 antialias:true

});

renderer.setSize(window.innerWidth,window.innerHeight);

renderer.setPixelRatio(Math.min(devicePixelRatio,2));

renderer.shadowMap.enabled=true;

renderer.shadowMap.type=THREE.PCFSoftShadowMap;

renderer.toneMapping=THREE.ACESFilmicToneMapping;

renderer.toneMappingExposure=1.15;

document.body.appendChild(renderer.domElement);

// LIGHTING

scene.add(new THREE.HemisphereLight(0xd8eeff,0x536044,2));

const sun = new THREE.DirectionalLight(0xffffff,3);

sun.position.set(-300,500,200);

sun.castShadow=true;

scene.add(sun);

// TERRAIN

const terrainGeo = new THREE.PlaneGeometry(5000,5000,120,120);

terrainGeo.rotateX(-Math.PI/2);

const pos = terrainGeo.attributes.position;

for(let i=0;i<pos.count;i++){

 const x=pos.getX(i);

 const z=pos.getZ(i);

 let h=

 Math.sin(x*.008)*8+

 Math.cos(z*.009)*10+

 Math.sin((x+z)*.018)*3;

 pos.setY(i,h);

}

terrainGeo.computeVertexNormals();

const terrain = new THREE.Mesh(

 terrainGeo,

 new THREE.MeshStandardMaterial({

  color:0x477b43,

  roughness:1

 })

);

terrain.receiveShadow=true;

scene.add(terrain);

// RUNWAY

const runway = new THREE.Mesh(

 new THREE.PlaneGeometry(40,1000),

 new THREE.MeshStandardMaterial({

  color:0x30343a,

  roughness:.9

 })

);

runway.rotation.x=-Math.PI/2;

runway.position.y=0.2;

scene.add(runway);

// RUNWAY CENTER LINE

for(let i=0;i<40;i++){

 const line = new THREE.Mesh(

  new THREE.BoxGeometry(1,.08,9),

  new THREE.MeshStandardMaterial({color:0xffffff})

 );

 line.position.set(0,.28,480-i*25);

 scene.add(line);

}

// RUNWAY EDGE LIGHTS

for(let z=-480;z<500;z+=15){

 for(let x of [-21,21]){

  const light=new THREE.Mesh(

   new THREE.SphereGeometry(.35,8,8),

   new THREE.MeshBasicMaterial({color:0xffffff})

  );

  light.position.set(x,.6,z);

  scene.add(light);

 }

}

// CLOUDS

function createCloud(x,y,z){

 const cloud=new THREE.Group();

 for(let i=0;i<7;i++){

  const mesh=new THREE.Mesh(

   new THREE.SphereGeometry(

    7+Math.random()*5,12,12

   ),

   new THREE.MeshStandardMaterial({

    color:0xffffff,

    roughness:1

   })

  );

  mesh.position.set(

   (Math.random()-.5)*20,

   Math.random()*5,

   (Math.random()-.5)*15

  );

  cloud.add(mesh);

 }

 cloud.position.set(x,y,z);

 scene.add(cloud);

}

for(let i=0;i<55;i++){

 createCloud(

  (Math.random()-.5)*2500,

  120+Math.random()*300,

  (Math.random()-.5)*2500

 );

}

// AIRCRAFT

const aircraft=new THREE.Group();

scene.add(aircraft);

const white=new THREE.MeshStandardMaterial({

 color:0xe9edf1,metalness:.25,roughness:.45

});

const blue=new THREE.MeshStandardMaterial({

 color:0x174b8c,metalness:.3,roughness:.4

});

const dark=new THREE.MeshStandardMaterial({

 color:0x252a30,roughness:.5

});

// FUSELAGE

function part(geo,mat,x,y,z){

 const m=new THREE.Mesh(geo,mat);

 m.position.set(x,y,z);

 m.castShadow=true;

 aircraft.add(m);

 return m;

}

part(new THREE.CylinderGeometry(.7,.9,9,20),white,

 0,0,0).rotation.x=Math.PI/2;

// Nose

part(new THREE.ConeGeometry(.7,3,20),blue,

 0,0,-6).rotation.x=-Math.PI/2;

// Cockpit

part(new THREE.SphereGeometry(1.15,20,16),blue,

 0,.85,-1.5).scale.set(1,.7,2);

// Main wings

part(new THREE.BoxGeometry(19,.22,2.5),white,

 0,0,0);

// Wing tips

part(new THREE.BoxGeometry(2,.25,2.6),blue,

 -9.5,0,0);

part(new THREE.BoxGeometry(2,.25,2.6),blue,

 9.5,0,0);

// Horizontal stabilizer

part(new THREE.BoxGeometry(7,.2,1.5),white,

 0,.3,4);

// Vertical tail

part(new THREE.BoxGeometry(.25,2,1.6),blue,

 0,1.1,4);

// Propeller

const prop=new THREE.Group();

aircraft.add(prop);

const bladeMat=dark;

for(let i=0;i<2;i++){

 const blade=new THREE.Mesh(

  new THREE.BoxGeometry(.18,4,0.2),

  bladeMat

 );

 blade.rotation.z=i*Math.PI;

 blade.position.z=-7.3;

 prop.add(blade);

}

// LANDING GEAR

for(let x of [-2.5,2.5]){

 const leg=part(new THREE.CylinderGeometry(.08,.08,1.3),dark,

 x,-1,0);

 const wheel=part(

  new THREE.TorusGeometry(.35,.13,8,16),

  dark,x,-1.7,0

 );

 wheel.rotation.y=Math.PI/2;

}

// FLIGHT STATE

const state={

 speed:0,

 throttle:0,

 pitch:0,

 roll:0,

 yaw:0,

 heading:0,

 altitude:5

};

const keys={};

window.addEventListener('keydown',e=>{

 keys[e.key.toLowerCase()]=true;

 if(e.key===' ')e.preventDefault();

});

window.addEventListener('keyup',e=>{

 keys[e.key.toLowerCase()]=false;

});

document.querySelectorAll('[data-key]').forEach(btn=>{

 const key=btn.dataset.key;

 btn.addEventListener('pointerdown',e=>{

  e.preventDefault();

  keys[key]=true;

 });

 ['pointerup','pointerleave','pointercancel'].forEach(ev=>{

  btn.addEventListener(ev,()=>{

   keys[key]=false;

  });

 });

});

// RESET

function reset(){

 aircraft.position.set(0,1,100);

 aircraft.rotation.set(0,0,0);

 state.speed=0;

 state.throttle=0;

 state.pitch=0;

 state.roll=0;

 state.yaw=0;

 state.heading=0;

}

document.getElementById('reset').onclick=reset;

reset();

// CLOCK

const clock=new THREE.Clock();

// GAME LOOP

function animate(){

 requestAnimationFrame(animate);

 const dt=Math.min(clock.getDelta(),.04);

 // THROTTLE

 if(keys.shift)state.throttle+=35*dt;

 if(keys.control||keys.ctrl)state.throttle-=35*dt;

 state.throttle=THREE.MathUtils.clamp(

  state.throttle,0,100

 );

 // AIRCRAFT CONTROL

 const pitchInput=

  (keys.w?1:0)-(keys.s?1:0);

 const rollInput=

  (keys.a?1:0)-(keys.d?1:0);

 const yawInput=

  (keys.q?1:0)-(keys.e?1:0);

 state.pitch+=pitchInput*1.1*dt;

 state.roll+=rollInput*1.5*dt;

 state.yaw+=yawInput*.8*dt;

 // NATURAL STABILITY

 state.pitch*=Math.pow(.985,dt*60);

 state.roll*=Math.pow(.985,dt*60);

 state.yaw*=Math.pow(.99,dt*60);

 state.pitch=THREE.MathUtils.clamp(

  state.pitch,-.65,.65

 );

 state.roll=THREE.MathUtils.clamp(

  state.roll,-.9,.9

 );

 // ENGINE SPEED

 const targetSpeed=state.throttle*1.15;

 const brake=keys.space?2:0;

 state.speed+=(

  (targetSpeed-state.speed)*.35-brake

 )*dt;

 state.speed=Math.max(0,state.speed);

 // AIRCRAFT ROTATION

 aircraft.rotation.order='YXZ';

 aircraft.rotation.y+=

  (state.yaw+state.roll*.35)*dt;

 aircraft.rotation.x=state.pitch;

 aircraft.rotation.z=state.roll;

 // FORWARD DIRECTION

 const forward=new THREE.Vector3(0,0,-1);

 forward.applyQuaternion(aircraft.quaternion);

 // LIFT AND ALTITUDE

 const velocity=state.speed*.65;

 const lift=Math.max(0,state.speed-25)*.035;

 const verticalSpeed=

  Math.sin(state.pitch)*velocity+

  lift*.45;

 aircraft.position.addScaledVector(forward,

  velocity*dt

 );

 aircraft.position.y+=verticalSpeed*dt;

 // GROUND

 if(aircraft.position.y<1){

  aircraft.position.y=1;

  aircraft.rotation.x=Math.min(

   aircraft.rotation.x,0

  );

 }

 // HEADING

 state.heading=(

  THREE.MathUtils.radToDeg(aircraft.rotation.y)%360+360

 )%360;

 state.altitude=aircraft.position.y;

 // PROPELLER

 prop.rotation.z+=state.speed*.12;

 // CAMERA FOLLOW

 const cameraOffset=new THREE.Vector3(0,5,17);

 cameraOffset.applyQuaternion(aircraft.quaternion);

 const cameraTarget=aircraft.position.clone()

  .add(cameraOffset);

 camera.position.lerp(cameraTarget,1-Math.pow(.001,dt));

 const lookTarget=aircraft.position.clone()

  .add(forward.clone().multiplyScalar(20));

 camera.lookAt(lookTarget);

 // HUD

 document.getElementById('speed').textContent=

  Math.round(state.speed*1.943);

 document.getElementById('alt').textContent=

  Math.round(state.altitude*3.281);

 document.getElementById('heading').textContent=

  Math.round(state.heading).toString().padStart(3,'0');

 document.getElementById('throttle').textContent=

  Math.round(state.throttle);

 document.getElementById('pitch').textContent=

  Math.round(THREE.MathUtils.radToDeg(state.pitch));

 document.getElementById('roll').textContent=

  Math.round(THREE.MathUtils.radToDeg(state.roll));

 renderer.render(scene,camera);

}

animate();

// RESIZE

window.addEventListener('resize',()=>{

 camera.aspect=window.innerWidth/window.innerHeight;

 camera.updateProjectionMatrix();

 renderer.setSize(window.innerWidth,window.innerHeight);

});

</script>

</body>

</html>
